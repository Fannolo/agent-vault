#!/bin/sh
# TEMPLATE. Not run by development verification. Review, then run once as root:
#   sudo AGENT_VAULT_INSTALL=dedicated-account sh install-broker.sh.template \
#        --client-uid <uid of the user running the bridge and app> \
#        --approval-public-key <base64 X9.63 P-256 public key> \
#        --broker-binary <Developer ID signed dev.agentvault.broker>
# Creates the hidden _agentvault account, /Library/Application Support/AgentVault/config.json,
# the broker's private /private/var/db/agent-vault directory and seeds, and the LaunchDaemon.
# Re-running converges to the same state and keeps existing seeds. It touches no other
# accounts, keychains, applications or launchd jobs.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022

[ "$(id -u)" -eq 0 ] || { echo "install-broker: run as root" >&2; exit 1; }
[ "${AGENT_VAULT_INSTALL:-}" = "dedicated-account" ] || {
  echo "install-broker: set AGENT_VAULT_INSTALL=dedicated-account to confirm" >&2; exit 1; }

client_uid=""; approval_key=""; broker_binary=""
while [ $# -gt 0 ]; do
  case "$1" in
    --client-uid) client_uid=$2; shift 2 ;;
    --approval-public-key) approval_key=$2; shift 2 ;;
    --broker-binary) broker_binary=$2; shift 2 ;;
    *) echo "install-broker: unknown argument" >&2; exit 64 ;;
  esac
done
case "$client_uid" in ''|*[!0-9]*) echo "install-broker: --client-uid must be numeric" >&2; exit 64 ;; esac
[ "$client_uid" -ne 0 ] || { echo "install-broker: the client cannot be root" >&2; exit 1; }
case "$approval_key" in ''|*[!A-Za-z0-9+/=]*) echo "install-broker: --approval-public-key must be base64" >&2; exit 64 ;; esac
[ "$(printf %s "$approval_key" | base64 -D | wc -c | tr -d ' ')" = 65 ] &&
  [ "$(printf %s "$approval_key" | base64 -D | head -c 1 | od -An -tx1 | tr -d ' ')" = 04 ] || {
  echo "install-broker: approval key must be an uncompressed X9.63 P-256 public key" >&2; exit 64; }
[ -f "$broker_binary" ] || { echo "install-broker: --broker-binary missing" >&2; exit 64; }

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
account=_agentvault
label=dev.agentvault.broker
support="/Library/Application Support/AgentVault"
private=/private/var/db/agent-vault
helper="/Library/PrivilegedHelperTools/$label"
plist="/Library/LaunchDaemons/$label.plist"

render() {
  sed -e "s|@BROKER_UID@|$1|" -e "s|@CLIENT_UID@|$client_uid|" -e "s|@APPROVAL_PUBLIC_KEY@|$approval_key|" \
    "$here/config.json.template"
}

broker_requirement=$(render 1 | plutil -extract ipc.brokerRequirement raw -o - -)
codesign --verify --strict -R="$broker_requirement" "$broker_binary" || {
  echo "install-broker: broker binary does not satisfy ipc.brokerRequirement" >&2; exit 1; }

if dscl . -read "/Users/$account" UniqueID >/dev/null 2>&1; then
  broker_uid=$(dscl . -read "/Users/$account" UniqueID | awk '{print $2}')
  [ "$(dscl . -read "/Users/$account" UserShell | awk '{print $2}')" = /usr/bin/false ] || {
    echo "install-broker: existing $account has an unexpected shell" >&2; exit 1; }
else
  broker_uid=""
  candidate=200
  while [ "$candidate" -lt 400 ]; do
    if ! dscl . -search /Users UniqueID "$candidate" | grep -q . &&
       ! dscl . -search /Groups PrimaryGroupID "$candidate" | grep -q .; then
      broker_uid=$candidate; break
    fi
    candidate=$((candidate + 1))
  done
  [ -n "$broker_uid" ] || { echo "install-broker: no free UID in 200-399" >&2; exit 1; }
  dscl . -create "/Groups/$account"
  dscl . -create "/Groups/$account" PrimaryGroupID "$broker_uid"
  dscl . -create "/Groups/$account" Password '*'
  dscl . -create "/Users/$account"
  dscl . -create "/Users/$account" UniqueID "$broker_uid"
  dscl . -create "/Users/$account" PrimaryGroupID "$broker_uid"
  dscl . -create "/Users/$account" UserShell /usr/bin/false
  dscl . -create "/Users/$account" NFSHomeDirectory /var/empty
  dscl . -create "/Users/$account" RealName "Agent Vault broker"
  dscl . -create "/Users/$account" Password '*'
  dscl . -create "/Users/$account" IsHidden 1
fi
[ "$broker_uid" -ne "$client_uid" ] || { echo "install-broker: broker and client UIDs must differ" >&2; exit 1; }

install -d -o root -g wheel -m 0755 "$support" /Library/PrivilegedHelperTools
install -d -o "$account" -g "$account" -m 0700 "$private"
for seed in keychain.password state-integrity.key; do
  if [ ! -e "$private/$seed" ]; then
    (umask 077 && dd if=/dev/urandom of="$private/$seed.new" bs=32 count=1 2>/dev/null)
    chown "$account:$account" "$private/$seed.new"; chmod 0400 "$private/$seed.new"
    mv "$private/$seed.new" "$private/$seed"
  fi
done

render "$broker_uid" > "$support/config.json.new"
plutil -lint -s "$support/config.json.new"
chown root:wheel "$support/config.json.new"; chmod 0644 "$support/config.json.new"
mv -f "$support/config.json.new" "$support/config.json"
install -o root -g wheel -m 0755 "$broker_binary" "$helper"
install -o root -g wheel -m 0644 "$here/$label.plist.template" "$plist"
plutil -lint -s "$plist"

launchctl bootout "system/$label" 2>/dev/null || true
launchctl bootstrap system "$plist"
echo "install-broker: $label installed for broker UID $broker_uid and client UID $client_uid"
